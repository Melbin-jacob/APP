# --- Core -------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/homeservices?schema=public"
REDIS_URL="redis://localhost:6379"
APP_URL="http://localhost:3000"

# --- Auth (NextAuth) --------------------------------------------------
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Email ------------------------------------------------------------
# "ses" | "smtp" | "console" (console logs emails; dev only)
EMAIL_TRANSPORT="console"
EMAIL_FROM="GetTradePros <no-reply@gettradepros.com>"
AWS_REGION="eu-west-2"
SMTP_URL="smtp://user:pass@localhost:1025"

# --- Markets, postal codes, currencies ----------------------------------
# Countries open for business, in display order (first = fallback market for
# visitors elsewhere). Build-time: rebuild after changing it.
NEXT_PUBLIC_SUPPORTED_COUNTRIES="CA,US"
# Optional overrides. Defaults: https://api.zippopotam.us (US, CA),
# https://api.postcodes.io (GB), https://api.frankfurter.app/latest?from=USD (ECB rates).
# ZIPPOPOTAM_URL=""
# POSTCODES_IO_URL=""
# FX_RATES_URL=""

# --- Review tokens ----------------------------------------------------
# Server-side pepper mixed into review token hashes.
REVIEW_TOKEN_PEPPER="replace-with-openssl-rand-hex-32"
REVIEW_TOKEN_TTL_DAYS="14"

# --- Legal entity (shown in legal pages, footer and every commercial email) ---
# CAN-SPAM and CASL require a real mailing address in commercial email.
LEGAL_ENTITY_NAME="GetTradePros Inc."
LEGAL_ADDRESS="123 Example Street, Suite 100, Toronto, ON M5V 3L9, Canada"
LEGAL_JURISDICTION="These terms are governed by the laws of the Province of Ontario and the federal laws of Canada applicable there."
PRIVACY_OFFICER="Jane Doe, Privacy Officer"
PRIVACY_EMAIL="privacy@gettradepros.com"
SECURITY_EMAIL="security@gettradepros.com"
SUPPORT_EMAIL="support@gettradepros.com"
# Contact page; shown as "Coming soon" until set.
CONTACT_PHONE="+1 519-555-0100"
CONTACT_HOURS="Monday to Friday, 9 am to 5 pm ET"

# --- Ops ------------------------------------------------------------------
# Bearer secret for /api/cron/* (EventBridge Scheduler / Vercel Cron).
CRON_SECRET="replace-with-openssl-rand-hex-32"

# --- Analytics ------------------------------------------------------------
# Calendar used for the daily visitor count in the ops console.
# STATS_TIMEZONE="America/Toronto"

# --- Security -------------------------------------------------------------
# Encrypts two-step sign-in secrets (AES-256-GCM). 32 random bytes, base64:
#   openssl rand -base64 32
# Required in production; development derives one from NEXTAUTH_SECRET.
MFA_ENCRYPTION_KEY=""
# Two-step sign-in is mandatory for staff. "false" is allowed only in development.
# REQUIRE_ADMIN_MFA="true"
# Staff session length and the step-up window for sensitive actions (seconds).
# ADMIN_SESSION_SECONDS="43200"
# RECENT_AUTH_SECONDS="900"
# Local Docker only: lets NODE_ENV=production run with the public test secrets
# when APP_URL is localhost. Never set this anywhere else.
# ALLOW_INSECURE_LOCAL_SECRETS="true"

# Address suggestions on address fields. Default: the free public Photon
# server (OpenStreetMap; fair use, fine for testing). For production either
# set a Geoapify key (free tier 3,000 lookups/day) or point PHOTON_URL at
# your own Photon instance.
GEOAPIFY_API_KEY=""
PHOTON_URL=""
